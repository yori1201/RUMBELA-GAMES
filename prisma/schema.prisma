// ============================================================
// RUMBELA GAMES — Adaptive Learning Platform Schema
// Phase 1 implementation per PRD v1 Section 11
//
// Database provider: SQLite untuk dev, PostgreSQL untuk production
// (provider di-set via env DATABASE_URL scheme - prisma auto-detect)
//
// Migration strategy:
// - Phase 1: Student profile + onboarding (this file)
// - Phase 2: Subject/Competency/Level/Question models
// - Phase 3: GameSession/AnswerAttempt/MasteryEvent
// - Phase 4+: Integration with existing game modes
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Untuk dev: file:./db/custom.db (SQLite)
  // Untuk production: postgresql://... (PostgreSQL managed)
  // Prisma mendeteksi provider dari URL scheme:
  //   file:... = sqlite
  //   postgresql://... = postgresql
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY & PROFILE (Phase 1)
// ============================================================

/// Siswa yang sudah menyelesaikan onboarding.
/// Satu access code = satu student profile.
model Student {
  id                String   @id @default(cuid())
  accessIdentityId  String   @unique
  displayName       String
  avatarKey         String?

  // PRD Section 5.2: jenjang & kelas
  // PAUD | TK | SD | SMP | SMA
  educationStage    String
  // TK_A | TK_B | SD_1..SD_6 | SMP_7..SMP_9 | SMA_10..SMA_12
  // Lihat src/lib/curriculum-data.ts untuk valid values
  gradeCode         String

  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accessIdentity    AccessIdentity @relation(fields: [accessIdentityId], references: [id])

  @@index([educationStage, gradeCode])
}

/// Identitas akses berbasis kode (mempertahankan mekanisme existing).
/// Hash disimpan, bukan plaintext. Device binding opsional.
model AccessIdentity {
  id              String    @id @default(cuid())
  accessCodeHash  String    @unique
  status          String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  deviceBinding   String?
  note            String?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  student         Student?

  @@index([status])
}

